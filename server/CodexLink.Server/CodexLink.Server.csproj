<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Alpine containers compile with their native clang/OpenSSL toolchain. -->
  <Import Project="Sdk.props" Sdk="StuDev.AotAnywhere" Condition="'$(UseNativeAotToolchain)' != 'true'" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.9</Version>
    <Authors>CodexLink contributors</Authors>
    <RepositoryUrl>https://github.com/mysteriousmy/CodexLink</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <IlcDehydrate>true</IlcDehydrate>
    <StackTraceSupport>false</StackTraceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux-musl-'))">
    <InvariantGlobalization>true</InvariantGlobalization>
    <StaticExecutable>true</StaticExecutable>
    <StaticOpenSslLinking>true</StaticOpenSslLinking>
    <PositionIndependentExecutable>false</PositionIndependentExecutable>
  </PropertyGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-musl-'))">
    <DirectPInvoke Include="libc" />
  </ItemGroup>
  <Import Project="FlutterWeb.targets" />
  <Import Project="Sdk.targets" Sdk="StuDev.AotAnywhere" Condition="'$(UseNativeAotToolchain)' != 'true'" />
  <Import Project="WindowsX64Cross.targets" />
</Project>
